<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f7f6; padding: 20px; display: none; /* Hidden until login confirmed */ }
        .container { max-width: 600px; margin: 0 auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        .section { margin-bottom: 30px; padding-bottom: 20px; border-bottom: 1px solid #eee; }
        h1 { color: #2c3e50; }
        input, select { padding: 8px; margin: 5px 0; border: 1px solid #ccc; border-radius: 4px; }
        button { padding: 10px 15px; background-color: #2ecc71; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        button:hover { background-color: #27ae60; }
        .logout { float: right; background-color: #e74c3c; }
        .logout:hover { background-color: #c0392b; }
        .match-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; background: #f9f9f9; padding: 10px; border-radius: 4px; }
    </style>
</head>
<body id="adminBody">

<div class="container">
    <button class="logout" onclick="logout()">Logout</button>
    <h1>⚙️ Admin Dashboard</h1>
    <a href="index.html" target="_blank">View Live Standings (Opens in new tab)</a>
    <hr><br>

    <div class="section">
        <h3>1. Add a Team</h3>
        <input type="text" id="teamName" placeholder="Enter Team Name">
        <button onclick="addTeam()">Add Team</button>
    </div>

    <div class="section">
        <h3>2. Enter Match Score</h3>
        
        <div class="match-row">
            <div>
                <strong>Team A:</strong><br>
                <select id="teamASelect"><option>Loading...</option></select>
            </div>
            <div>
                <strong>Balls Left:</strong><br>
                <input type="number" id="teamABalls" min="0" max="10" style="width: 60px;">
            </div>
        </div>

        <div class="match-row">
            <div>
                <strong>Team B:</strong><br>
                <select id="teamBSelect"><option>Loading...</option></select>
            </div>
            <div>
                <strong>Balls Left:</strong><br>
                <input type="number" id="teamBBalls" min="0" max="10" style="width: 60px;">
            </div>
        </div>

        <button onclick="submitScore()">Submit Match Score</button>
    </div>
</div>

<script type="module">
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
  import { getFirestore, collection, addDoc, getDocs, doc, updateDoc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";

  /* --- PASTE YOUR FIREBASE CONFIG HERE --- */
  const firebaseConfig = {
    apiKey: "YOUR_API_KEY",
    authDomain: "YOUR_PROJECT.firebaseapp.com",
    projectId: "YOUR_PROJECT_ID",
    storageBucket: "YOUR_PROJECT.appspot.com",
    messagingSenderId: "YOUR_SENDER_ID",
    appId: "YOUR_APP_ID"
  };
  /* --------------------------------------- */

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);
  const db = getFirestore(app);

  // Security Check: Make sure admin is logged in
  onAuthStateChanged(auth, (user) => {
    if (user) {
      document.getElementById("adminBody").style.display = "block"; // Show page
      loadTeams(); // Load the dropdowns
    } else {
      window.location.href = "login.html"; // Kick back to login
    }
  });

  window.logout = function() {
    signOut(auth).then(() => {
      window.location.href = "login.html";
    });
  };

  async function loadTeams() {
    const querySnapshot = await getDocs(collection(db, "teams"));
    const selectA = document.getElementById("teamASelect");
    const selectB = document.getElementById("teamBSelect");
    selectA.innerHTML = ""; selectB.innerHTML = "";
    
    querySnapshot.forEach((doc) => {
      let optionStr = `<option value="${doc.id}">${doc.data().name}</option>`;
      selectA.innerHTML += optionStr;
      selectB.innerHTML += optionStr;
    });
  }

  window.addTeam = async function() {
    const nameInput = document.getElementById("teamName");
    const name = nameInput.value.trim();
    if(!name) return alert("Enter a team name!");
    
    await addDoc(collection(db, "teams"), {
      name: name,
      points: 0,
      balls: 0
    });
    alert(`Team '${name}' added!`);
    nameInput.value = ""; // Clear input
    loadTeams(); 
  };

  window.submitScore = async function() {
    const teamAId = document.getElementById("teamASelect").value;
    const teamBId = document.getElementById("teamBSelect").value;
    const aBallsInput = document.getElementById("teamABalls").value;
    const bBallsInput = document.getElementById("teamBBalls").value;

    if (teamAId === teamBId) return alert("Error: Team A and Team B cannot be the same team!");
    if (aBallsInput === "" || bBallsInput === "") return alert("Please enter the number of balls for both teams!");

    const aBalls = parseInt(aBallsInput);
    const bBalls = parseInt(bBallsInput);

    let aPoints = 0, bPoints = 0;
    if (aBalls < bBalls) { aPoints = 2; bPoints = 0; }      
    else if (bBalls < aBalls) { aPoints = 0; bPoints = 2; } 
    else { aPoints = 1; bPoints = 1; }                      

    if (confirm(`Submit Score?\nTeam A gets ${aPoints} points.\nTeam B gets ${bPoints} points.`)) {
        const teamADoc = await getDoc(doc(db, "teams", teamAId));
        const teamBDoc = await getDoc(doc(db, "teams", teamBId));
        
        const aData = teamADoc.data();
        const bData = teamBDoc.data();

        await updateDoc(doc(db, "teams", teamAId), {
          points: aData.points + aPoints,
          balls: aData.balls + aBalls
        });
        await updateDoc(doc(db, "teams", teamBId), {
          points: bData.points + bPoints,
          balls: bData.balls + bBalls
        });

        alert("Score submitted! Standings updated.");
        document.getElementById("teamABalls").value = "";
        document.getElementById("teamBBalls").value = "";
    }
  };
</script>

</body>
</html>
